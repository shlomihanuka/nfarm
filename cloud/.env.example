# Cloud Run service configuration
# Copy this to .env.local and fill in values. Never commit real credentials.

# GCP
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1

# Gemini — model IDs are configuration, not code
GEMINI_INTENT_MODEL=gemini-1.5-flash-002
GEMINI_RANKING_MODEL=gemini-1.5-flash-002
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Cloud SQL / pgvector
DATABASE_URL=postgresql://asc_user:CHANGE_ME@127.0.0.1:5432/asc_staging

# Service
PORT=8080
NODE_ENV=production
LOG_LEVEL=info

# Debug (admin-only token for GET /debug/:trace_id)
ASC_DEBUG_KEY=CHANGE_ME_min_32_chars

# Dev only — set to true to skip real Gemini calls and use mock responses
USE_MOCK_GEMINI=false
