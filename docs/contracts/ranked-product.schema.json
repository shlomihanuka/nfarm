{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "ranked-product",
  "title": "RankedProduct",
  "description": "A WooCommerce product card as returned from the cloud, extended with AI ranking fields. All inferred fields carry source, confidence, updated_at and approval_state.",
  "type": "object",
  "required": ["id", "name", "permalink", "image", "price_html", "in_stock", "type"],
  "additionalProperties": true,
  "properties": {
    "id": { "type": "integer" },
    "name": { "type": "string" },
    "permalink": { "type": "string", "format": "uri" },
    "image": { "type": "string", "format": "uri" },
    "price_html": { "type": "string" },
    "in_stock": { "type": "boolean" },
    "stock_status": { "type": "string" },
    "type": { "type": "string" },
    "is_weighted": { "type": "boolean" },
    "price_note": { "type": "string" },
    "ai_rank": {
      "type": "integer",
      "minimum": 1,
      "description": "1-based position in the AI-ranked result set."
    },
    "ai_reason": {
      "type": "string",
      "description": "Human-readable explanation of why this product was ranked here."
    },
    "suggest_qty": {
      "type": "integer",
      "minimum": 1,
      "description": "Suggested quantity for the query context (e.g. servings × pack size). Never used to modify cart directly — only a UI hint."
    },
    "inferred_attrs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key", "value", "source", "confidence", "updated_at", "approval_state"],
        "additionalProperties": false,
        "properties": {
          "key": { "type": "string" },
          "value": {},
          "source": {
            "type": "string",
            "enum": ["gemini_inference", "catalog_import", "admin_verified"]
          },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "updated_at": { "type": "string", "format": "date-time" },
          "approval_state": {
            "type": "string",
            "enum": ["pending", "approved", "rejected"],
            "description": "Allergen and origin fields must be approved before display. review_required is true when approval_state is pending."
          },
          "review_required": { "type": "boolean" }
        }
      }
    }
  }
}
