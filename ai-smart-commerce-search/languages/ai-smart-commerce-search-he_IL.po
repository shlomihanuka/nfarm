#. Plugin Name of the plugin
msgid "AI Smart Commerce Search"
msgstr "חיפוש חכם לחנות"

#. Description of the plugin
msgid "AI-driven search, substitutes, recommendations and purchase assistance for WooCommerce stores."
msgstr "חיפוש מונחה בינה מלאכותית, תחליפים, המלצות וסיוע ברכישה לחנויות WooCommerce."

#: ai-smart-commerce-search.php
msgid "AI Smart Commerce Search requires WooCommerce. Please install and activate it."
msgstr "חיפוש חכם לחנות דורש WooCommerce. אנא התקן והפעל אותו."

#: includes/class-asc-search.php
msgid "What are you looking for? E.g. \"Shabbat dinner for five, on sale\""
msgstr "מה תרצו למצוא היום? אפשר לשאול אותי חופשי..."

#: includes/class-asc-search.php
msgid "No products found"
msgstr "לא נמצאו מוצרים"

#: includes/class-asc-search.php
msgid "Add to cart"
msgstr "הוסף לסל"

#: includes/class-asc-search.php
msgid "Adding\xe2\x80\xa6"
msgstr "מוסיף\xe2\x80\xa6"

#: includes/class-asc-search.php
msgid "Added to cart"
msgstr "נוסף לסל"

#: includes/class-asc-search.php
msgid "Error adding to cart"
msgstr "שגיאה בהוספה לסל"

#: includes/class-asc-search.php
msgid "Please select all options"
msgstr "יש לבחור את כל האפשרויות"

#: includes/class-asc-search.php
msgid "In stock"
msgstr "במלאי"

#: includes/class-asc-search.php
msgid "Out of stock"
msgstr "אזל מהמלאי"

#: includes/class-asc-search.php
msgid "Quantity"
msgstr "כמות"

#: includes/class-asc-search.php
msgid "Close search"
msgstr "סגור חיפוש"

#: includes/class-asc-search.php
msgid "Searching\xe2\x80\xa6"
msgstr "מחפש\xe2\x80\xa6"

#: includes/class-asc-search.php
msgid "Final price depends on actual weight at time of purchase."
msgstr "המחיר הסופי נקבע לפי המשקל בפועל בעת הרכישה."

#: includes/class-asc-search.php
msgid "AI is analyzing your request\xe2\x80\xa6"
msgstr "AI מנתח את הבקשה שלך..."

#: includes/class-asc-search.php
msgid "AI is finding relevant products\xe2\x80\xa6"
msgstr "AI מחפש מוצרים רלוונטיים..."

#: includes/class-asc-search.php
msgid "AI is ranking results for you\xe2\x80\xa6"
msgstr "AI מדרג את התוצאות עבורך..."

#: includes/class-asc-search.php
msgid "Show {n} more results"
msgstr "הצג {n} תוצאות נוספות"

#: includes/class-asc-cloud.php
msgid "Cloud API URL and Project ID are required."
msgstr "נדרשים כתובת API לענן ומזהה פרויקט."

#: includes/class-asc-cloud.php
msgid "Connected"
msgstr "מחובר"

#: includes/class-asc-cloud.php
msgid "Authentication Failed"
msgstr "אימות נכשל"

#: includes/class-asc-cloud.php
msgid "Permission Missing"
msgstr "אין הרשאה"

#: includes/class-asc-cloud.php
#, php-format
msgid "API Unavailable (HTTP %d)"
msgstr "ה-API אינו זמין (HTTP %d)"

#: admin/class-asc-admin.php
msgid "AI Smart Search Settings"
msgstr "הגדרות חיפוש חכם"

#: admin/class-asc-admin.php
msgid "AI Smart Search"
msgstr "חיפוש חכם"

#: admin/class-asc-admin.php
msgid "You do not have permission to access this page."
msgstr "אין לך הרשאה לגשת לדף זה."

#: admin/class-asc-admin.php
msgid "Insufficient permissions."
msgstr "הרשאות לא מספקות."

#: admin/class-asc-admin.php
msgid "Settings saved."
msgstr "ההגדרות נשמרו."

#: admin/class-asc-admin.php
msgid "Testing\xe2\x80\xa6"
msgstr "בודק\xe2\x80\xa6"

#: admin/class-asc-admin.php
msgid "API Unavailable"
msgstr "ה-API אינו זמין"

#: admin/class-asc-admin.php
msgid "Not Configured"
msgstr "לא מוגדר"

#: admin/views/settings.php
msgid "Search Drawer"
msgstr "חלונית החיפוש"

#: admin/views/settings.php
msgid "Enable AI Smart Search"
msgstr "הפעלת חיפוש חכם"

#: admin/views/settings.php
msgid "Uncheck to disable the drawer and restore native site search."
msgstr "בטל סימון להשבתת החלונית ולשחזור חיפוש האתר המובנה."

#: admin/views/settings.php
msgid "Cloud Setup"
msgstr "הגדרות ענן"

#: admin/views/settings.php
msgid "Leave blank to run in local-search-only mode (no AI features)."
msgstr "השאר ריק להפעלה במצב חיפוש מקומי בלבד (ללא תכונות AI)."

#: admin/views/settings.php
msgid "Project ID"
msgstr "מזהה פרויקט"

#: admin/views/settings.php
msgid "Environment"
msgstr "סביבה"

#: admin/views/settings.php
msgid "Production"
msgstr "ייצור"

#: admin/views/settings.php
msgid "Testing"
msgstr "בדיקות"

#: admin/views/settings.php
msgid "Development"
msgstr "פיתוח"

#: admin/views/settings.php
msgid "Region"
msgstr "אזור"

#: admin/views/settings.php
msgid "Tenant ID"
msgstr "מזהה לקוח"

#: admin/views/settings.php
msgid "Cloud API Base URL"
msgstr "כתובת API בסיסית לענן"

#: admin/views/settings.php
msgid "Cloud Run service URL. Leave empty to run in local mode."
msgstr "כתובת שירות Cloud Run. השאר ריק להפעלה במצב מקומי."

#: admin/views/settings.php
msgid "Connection Check"
msgstr "בדיקת חיבור"

#: admin/views/settings.php
msgid "Save Settings"
msgstr "שמירת הגדרות"
